# ===== Moravo =====
# Copie este arquivo para .env e ajuste os valores conforme o ambiente.
# cp .env.example .env

# Porta onde o Express escuta (o host geralmente faz proxy pra 80/443)
PORT=3001

# Banco Supabase Postgres
# DATABASE_URL=postgresql://postgres:SUA_SENHA@db.SEU_PROJETO.supabase.co:5432/postgres

# Origens permitidas pelo CORS.
# Como front e back estão no mesmo domínio, CORS é desnecessário.
# Em produção, deixe vazio. Use * só pra liberar geral durante desenvolvimento.
CORS_ORIGIN=

# Ambiente: development | production
NODE_ENV=production

# ===== JWT =====
# Segredo usado pra assinar/verificar tokens. Em produção, o servidor
# se recusa a subir se JWT_SECRET não estiver definido (fail-fast).
# Gere um valor único com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# TTL do token em horas (default 168 = 7 dias)
JWT_EXPIRES_IN=168

# ===== Waha (WhatsApp API) =====
# URL base do Waha (sem barra no final)
WAHA_URL=https://wpp.atendentex.com.br

# Chave de API do Waha (enviada no header X-API-Key)
WAHA_API_KEY= 0d5f426983d0d5bcd4a20816153aa42be1d72e546

# Nome da sessão configurada no Waha (default = "default")
WAHA_SESSION=moravo_portal

# Número do atendente principal que entra em todos os grupos (com DDI 55)
# Apenas dígitos, ex: 5515981829650
WAHA_ATENDENTE_PRINCIPAL=5515981829650

# Números internos extras que entram no grupo junto com o atendente.
# O grupo NÃO adiciona mais proprietário e corretor à força: eles entram pelo
# link de convite enviado pela API oficial. Como a API do Waha costuma exigir
# mais de um participante, aponte aqui um segundo número da Moravo se precisar.
# Apenas dígitos, separados por vírgula.
WAHA_PARTICIPANTES_EXTRA=

# ===== WhatsApp Cloud API (oficial, Meta) =====
# Phone Number ID, WABA ID, versão e token são configurados pelo PAINEL DO ADMIN
# (/admin → Config. WhatsApp) e ficam no banco, com o token cifrado.
#
# Esta chave é o que cifra o token. Sem ela, o painel não consegue salvar.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Se ficar vazia, o sistema usa JWT_SECRET como reserva.
CONFIG_SECRET=
